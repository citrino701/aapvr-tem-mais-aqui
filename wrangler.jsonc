{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aapvr-tem-mais-aqui",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "previews": {}
}
